<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Works around .NET SDK 11.0.100 failing Debug builds with "scoped css bundles do not have
         matching endpoints" (BlazorWeb.HotReload module). Remove once fixed:
         https://github.com/dotnet/aspnetcore/issues/70014 (tracked in #215). -->
    <EnableHotReloadInRuntimeConfigDevFile>false</EnableHotReloadInRuntimeConfigDevFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arius.Api\Arius.Api.csproj" />
    <ProjectReference Include="..\Arius.Core\Arius.Core.csproj" />
  </ItemGroup>

</Project>
